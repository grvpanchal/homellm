[Unit]
Description=homellm node agent (watchdog, model switching, LAN discovery)
After=network-online.target

[Service]
ExecStart=%h/.local/share/homellm/venv/bin/homellm node
EnvironmentFile=%h/.config/homellm/node.env
Restart=always
RestartSec=5
# llama-server runs in its own transient unit (homellm-llamacpp), so restarting the agent leaves it serving

[Install]
WantedBy=default.target
